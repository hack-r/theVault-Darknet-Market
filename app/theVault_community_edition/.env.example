APP_NAME=Marketplace
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# Set to http://<your-address>.onion once the onion service has a hostname.
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=marketplace
DB_USERNAME=thevault
DB_PASSWORD=change-me

# Sessions, cache and queue live in the database (tables are in the demo dump / migrations).
SESSION_DRIVER=database
SESSION_LIFETIME=120
# Onion services are served over plain HTTP; secure cookies would never be sent.
SESSION_SECURE_COOKIE=false
CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_DRIVER=null
MAIL_MAILER=log

# Search backend. "database" needs no extra service (fits a 2 GB box).
# Use "elasticsearch" only if you run Elasticsearch (4 GB+ RAM recommended).
SCOUT_DRIVER=database

MARKET_FEE_PERCENT=5
VENDOR_FEE=100
MARKETPLACE_JSWARNING=true
